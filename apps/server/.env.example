NODE_ENV=development
HOST=127.0.0.1
PORT=3333
CLIENT_ORIGIN=http://localhost:5173
CLIENT_ORIGINS=
DATABASE_URL=file:./noctua.db
# Optional on loopback; required when HOST is not 127.0.0.1 or localhost.
API_TOKEN=
# Keep local until Firebase has been configured on both the panel and the server.
AUTH_MODE=local
FIREBASE_PROJECT_ID=
OWNER_EMAIL=
BACKUP_DIR=backups/system
# In the persistent server, provide a mounted service account file or workload identity.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
# Common JSON forms only. Backup uploads/imports do not use this limit.
BODY_LIMIT_MB=40
RUST_LOG=info
# Relative to apps/server. Automatically created; keep this key together with the database.
WHATSAPP_KEY_FILE=.secrets/whatsapp.key
WHATSAPP_LOG_LEVEL=silent
WHATSAPP_SYNC_PHOTOS=true
WHATSAPP_MAX_RETRIES=5
