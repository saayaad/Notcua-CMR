{
  "name": "@noctua/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --import ./test/setup-env.mjs --test --test-concurrency=1 test/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "backup:import": "tsx src/cli/import-backup.ts",
    "backup:export": "tsx src/cli/export-backup.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "archiver": "^8.0.0",
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "exceljs": "^4.4.0",
    "express": "5.1.0",
    "ffmpeg-static": "5.3.0",
    "firebase-admin": "^14.5.0",
    "helmet": "8.1.0",
    "pino": "9.14.0",
    "qrcode": "1.5.4",
    "socket.io": "4.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/node": "22.19.0",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "6.0.3",
    "prisma": "6.19.3",
    "socket.io-client": "4.8.1",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
